// SpendSync data model. Run `npm run db:migrate` after changing this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseType {
  EXPENSE
  INCOME
}

enum Frequency {
  WEEKLY
  MONTHLY
}

model Expense {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  amount    Decimal     @db.Decimal(10, 2)
  category  String
  notes     String      @default("")
  type      ExpenseType @default(EXPENSE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([date])
  @@index([type])
}

model Budget {
  id           String   @id @default(cuid())
  category     String   @unique
  monthlyLimit Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Single-row application settings (id is always "app").
model Settings {
  id          String   @id @default("app")
  displayName String   @default("John Doe")
  updatedAt   DateTime @updatedAt
}

model RecurringRule {
  id        String      @id @default(cuid())
  category  String
  amount    Decimal     @db.Decimal(10, 2)
  notes     String      @default("")
  type      ExpenseType @default(EXPENSE)
  frequency Frequency   @default(MONTHLY)
  nextDate  DateTime    @db.Date
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([nextDate])
}

model SavingsGoal {
  id         String    @id @default(cuid())
  name       String
  target     Decimal   @db.Decimal(10, 2)
  saved      Decimal   @default(0) @db.Decimal(10, 2)
  targetDate DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
