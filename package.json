    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "15.0.2",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
